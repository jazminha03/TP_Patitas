@{
    ViewData["Title"] = "Profesionales";
    List<Profesional> profesionales = ViewBag.Profesionales;
}

<h1>Nuestros profesionales</h1>

<div id="listaProfesionales" class="grilla">
    @foreach (Profesional p in profesionales)
    {
        <a class="tarjeta" href="@Url.Action("Detalle", "Profesionales", new { id = p.IdProfesional })">
            <img src="@p.Imagen" alt="@p.Nombre" />
            <div class="tarjeta-info">
                <h3>@p.Nombre</h3>
                <span>@p.NombreCategoria</span>
            </div>
        </a>
    }
</div>

@if (ViewBag.HayMas)
{
    <button id="btnVerMas" type="button" data-url="@Url.Action("CargarMas", "Profesionales")">Ver más</button>
}