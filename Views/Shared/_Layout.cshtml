@{
    bool logueado = Context.Session.GetInt32("IdUsuario") != null;
    string nombre = Context.Session.GetString("Nombre");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Patitas</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <a class="marca" href="@Url.Action("Index", "Profesionales")">
            <div class="marca-icono">🐾</div>
            <div>
                <div class="marca-nombre">Patitas</div>
                <div class="marca-lema">Cuidamos a tus mascotas</div>
            </div>
        </a>

        <nav>
            <ul>
                @if (logueado)
                {
                    <li class="saludo">Hola, @nombre</li>
                    <li><a href="@Url.Action("Index", "Profesionales")">Profesionales</a></li>
                    <li><a href="@Url.Action("MisTurnos", "Turnos")">Mis turnos</a></li>
                    <li class="salir"><a href="@Url.Action("Logout", "Account")">Salir</a></li>
                }
                else
                {
                    <li><a href="@Url.Action("Login", "Account")">Ingresar</a></li>
                    <li><a href="@Url.Action("Registro", "Account")">Registrarme</a></li>
                }
            </ul>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        &copy; 2026 - Patitas
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>